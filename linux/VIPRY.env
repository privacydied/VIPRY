# Switches for fork 'VIPRY' (community NVIDIA merge). From its scripts/play-nvidia.ps1 (Pass 49
# defaults), Series S, RT off, adapted for RTX 3090 + Proton. Sourced by bash in steam-launch.
VICTORY_BUILD_PROFILE=release

# Core threading, relay, copy-back, barriers & descriptor sync
VICTORY_RELAY=2
VICTORY_CARD_STEPS=1
VICTORY_TEXTURE_NO_WAIT=0
VICTORY_WIDE_BACK=1
VICTORY_CARD_REHASH_RUNS=1
VICTORY_JOIN_COPIES=1
VICTORY_INDIRECT_WINDOW=1
VICTORY_RELAY_COPY=1
VICTORY_INDIRECT_BATCH=2
VICTORY_MAP_THREADS=1
VICTORY_TITLE_PRIORITIES=0
VICTORY_AFFINITY=free
VICTORY_SHOW_AFTER=1
# THIN blurs the picture on RTX 50 (Blackwell) only; RTX 3090 keeps it. Set 0 if the image is soft.
VICTORY_THIN=1
VICTORY_JOIN_PARTS=16
VICTORY_JOIN_LISTS=96
VICTORY_UPLOAD_AHEAD=1
VICTORY_LAND_ASIDE=1
VICTORY_LAND_SKIP=1
VICTORY_LAND_THREADS=8
VICTORY_VIEW_THREADS=8
# The script turns these on; they gave a black world (HUD + minimap only) in the merge author's runs.
VICTORY_SKIP_WC_BACK=0
VICTORY_SKIP_WC_COMPARE=0
VICTORY_SMART_BARRIERS=1
VICTORY_DEDUP_BARRIERS=1
VICTORY_COPY_BESIDE=1
VICTORY_STORE_BESIDE=1
VICTORY_MAP_LOCK_FINE=1
VICTORY_PARTIAL_DELTA=1
VICTORY_BAKE_DELTA=1
VICTORY_ASK_TEXTURES=1
VICTORY_REFRESH_ONCE=1
VICTORY_WINDOW_REUSE=1
VICTORY_LAZY_COPYBACK=1
VICTORY_UP_QUEUE=1
VICTORY_DISK_CORES=adaptive
VICTORY_CARD_AWAKE=0
VICTORY_WIDE_SPIN=10
VICTORY_LANE_CORE=0
VICTORY_UM_COALESCE_KB=0
VICTORY_SAMPLERS_MADE=0
VICTORY_PORT_JOURNAL=0
VICTORY_KEEP_PAGES=0
VICTORY_PRECISE_PACE=1
# Depth-plane & descriptor alias correctness + E5 render-target stand-in
VICTORY_PLANE_NOW=1
VICTORY_LIST_ALIAS_EXACT=1
VICTORY_E5_TARGETS=r11g11b10
# Card buffers (64 KiB threshold + 2048 MiB pool + fetch check)
VICTORY_CARD_BUFFERS_MIN_KB=64
VICTORY_CARD_BUFFERS_MB=2048
VICTORY_FETCH_CHECK=1
# Streaming, bakes, background pipeline compilation (+ book for `warm --used`)
VICTORY_SECTION_MB=2
VICTORY_TEXTURE_STAGE_MB=768
VICTORY_TEXTURE_STAGE_MS=50
VICTORY_TEXTURE_CATCHUP=1
VICTORY_BAKE_TEXTURES_MS=1500
VICTORY_PIPELINE_WORKERS=6
VICTORY_PIPELINE_LOWEST=1
# Script default is 500. First runs: long wait, or the world stays black while shaders compile.
# Drop back to 500 once the caches are warm.
VICTORY_PIPELINE_WAIT_MS=500
VICTORY_PIPELINE_BOOK=1
# Indirect light, interior haze clamp, glass/windows, specular stand-in
VICTORY_AMBIENT=0.75
VICTORY_AMBIENT_AIR=1.5
VICTORY_AMBIENT_MOST=2
VICTORY_AMBIENT_LEFTOVER=0
VICTORY_AMBIENT_SHADE=1.1,0.6
VICTORY_AMBIENT_REFLECT=0.65
VICTORY_AMBIENT_SETTLE=250,3
VICTORY_AMBIENT_MARCH=3
VICTORY_AMBIENT_SPECULAR=0.8,0.1
VICTORY_AMBIENT_SPECULAR_ALPHA=clamp
# Shader translator NVIDIA switches (part of the shader cache key)
VICTORY_NAN_SCRUB=1
VICTORY_BVH_MISS=1
VICTORY_NV_FLOAT=7
VICTORY_SPLIT_LDS_COALESCE=1
VICTORY_LDS_WRITE_ONLY_OK=1
# View-heap cap, 720p internal (0.6667 of Series S 1080p), own upscaler, UI plane, watchdog off
VICTORY_DYNAMIC_SLOTS=524288
VICTORY_RENDER_SCALE=0.6667
VICTORY_OWN_UPSCALER=1
VICTORY_COMPOSE=1
VICTORY_NO_WATCHDOG=1
# RT off: skip the 1,034 RT resolve/shadow + 43 RT-only shaders listed in the fork's scripts/.
_rt="$V/forks/VIPRY/scripts"
VICTORY_SKIP_PIPELINES="$(cat "$_rt/rt_off_hashes.txt" "$_rt/rt_work_off_hashes.txt" 2>/dev/null | tr -s ' \r\n,' ',' | sed 's/^,//; s/,$//')"
VICTORY_SKIP_SYNC=1
# Guard first-looks without the guards lock: -8.2 ms a frame (two A,B pairs, no crash).
VICTORY_FREE_LOOKS=1
unset _rt
# Above 30 fps: VICTORY_TARGET_FPS=60
VICTORY_ARGS="--execute --console series-s"
VICTORY_LOG="warn,victory_gpu::host=info"
