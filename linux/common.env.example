# Shared by every fork. Linux paths; steam-launch turns them into Wine Z:\ paths.
GAME_DIR="/home/pry/Grand Theft Auto VI/Game"
# Folder with AMD's signed amd_fidelityfx_upscaler_dx12.dll, for -Fsr4K style upscaling (optional).
# FIDELITYFX_DIR="/home/pry/Games/victory/fidelityfx"
# Two RTX 3090s here: pin the card by DXGI index or name part if the wrong one is picked.
# VICTORY_D3D12_ADAPTER=0
VICTORY_LOG=warn
# Bigger stacks for VIctory's own threads: pipeline workers overflow 2 MB under vkd3d-proton.
# 64 MB cut overflows in one test, not to zero; 256 MB starves title memory (XMemVirtualAlloc fails).
RUST_MIN_STACK=67108864
